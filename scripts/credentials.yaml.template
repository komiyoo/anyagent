# credentials.yaml.template
#
# Template for batch importing credentials (write-only) into anyagent Tool Runtime.
# Fill values via `value_from_env` in your deployment environment, or replace with direct `value`.
#
# Usage:
#   export ADMIN_API_KEY="adm_..."
#   export ADMIN_URL="http://127.0.0.1:8788"
#   export OPENAI_API_KEY="sk-..."
#   ./scripts/init-credentials.sh scripts/credentials.yaml.template
#
# Notes:
# - Do NOT commit real secrets to git.
# - `value_from_env` reads from your environment at import time.

credentials:
  - credential_id: cred_openai_default
    kind: api_key
    scope: { level: global }
    metadata:
      display_name: OpenAI API Key
      provider: openai
    value_from_env: OPENAI_API_KEY

  - credential_id: cred_websearch_default
    kind: api_key
    scope: { level: global }
    metadata:
      display_name: Web Search API Key
      provider: websearch
    value_from_env: WEBSEARCH_API_KEY

  - credential_id: cred_feishu_main
    kind: bearer_token
    scope: { level: agent, agent_id: main }
    metadata:
      display_name: Feishu Tenant Access Token
      provider: feishu
    value_from_env: FEISHU_TENANT_ACCESS_TOKEN

