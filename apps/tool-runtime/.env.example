# anyagent Tool Runtime demo config (copy to `.env`, then replace values)
#
# Recommended workflow:
#   cp .env.example .env
#   edit .env
#   uv run --env-file .env tool-runtime
#

# Internal auth (Agent API will call Tool Runtime with this key)
TOOL_RUNTIME_INTERNAL_KEY=dev-internal-key

# Optional: enable plugin loading (comma-separated roots).
# Example: TOOL_RUNTIME_PLUGIN_ROOTS=../../plugins
TOOL_RUNTIME_PLUGIN_ROOTS=

# Optional: enable Admin API for credentials.
ADMIN_API_KEY=

# Server listen
HOST=127.0.0.1
PORT=8788

# Security: sandbox.* tools are denied by default.
ALLOW_SANDBOX=false

