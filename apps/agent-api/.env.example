# anyagent Agent API demo config (copy to `.env`, then replace values)
#
# Notes:
# - `AGENT_API_KEY` is the auth key for callers talking to *this* Agent API.
# - `OPENAI_API_KEY` is the upstream OpenAI key used by this Agent API to call OpenAI.
# - `WORKSPACE_DIR` points to the Agent Packs/skills workspace root.
#
# Recommended workflow:
#   cp .env.example .env
#   edit .env  (at least: OPENAI_API_KEY)
#   uv run --env-file .env agent-api
#

# Agent API auth (callers should send: Authorization: Bearer <AGENT_API_KEY>)
AGENT_API_KEY=dev-agent-api-key

# Upstream OpenAI
OPENAI_API_KEY=sk-REPLACE_ME
OPENAI_BASE_URL=https://api.openai.com/v1

# Tool Runtime wiring (must match Tool Runtime config)
TOOL_RUNTIME_INTERNAL_KEY=dev-internal-key
TOOL_RUNTIME_BASE_URL=http://127.0.0.1:8788

# Agent Packs + skills workspace root.
# If you run `uv run agent-api` from `apps/agent-api`, this points to repo-root `.runs/demo-workspace`.
WORKSPACE_DIR=../../.runs/demo-workspace

# Demo storage mode (recommended for local demo).
# Writes rollouts under repo-root `.runs/` (gitignored).
STORAGE_MODE=none
ROLLOUT_ROOT_DIR=../../.runs/rollouts

# Server listen
HOST=127.0.0.1
PORT=8787

# Acceptance helpers (used by `scripts/acceptance_openai_sdk_smoke.py`)
ANYAGENT_AGENT_API_BASE_URL=http://127.0.0.1:8787
ANYAGENT_OPENAI_MODEL=gpt-4.1-mini

