# anyagent storage configuration
# Copy to .env and fill in values

# PostgreSQL connection (either POSTGRES_DSN or DATABASE_URL)
# POSTGRES_DSN takes precedence if both are set
DATABASE_URL=postgresql://lyriktrip:secret@127.0.0.1:5432/anyagent
# POSTGRES_DSN=postgresql://user:pass@host:5432/dbname

# PostgreSQL schema for logical isolation (default: public)
POSTGRES_SCHEMA=public

# Storage mode: none (in-memory) | external (PostgreSQL)
STORAGE_MODE=external

# Redis (optional, for hot path caching and session locks)
# REDIS_DSN=redis://127.0.0.1:6379/0

# Backend overrides (default: resolved from STORAGE_MODE)
# EVENT_STORE_BACKEND=external
# RUN_STORE_BACKEND=external
# SESSION_STORE_BACKEND=external
