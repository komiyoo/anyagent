{
  "id": "feishu",
  "channels": ["feishu"],
  "config_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["tenants"],
    "properties": {
      "base_url": {
        "type": "string",
        "default": "https://open.feishu.cn"
      },
      "timeout_ms": {
        "type": "integer",
        "minimum": 1000,
        "maximum": 60000,
        "default": 15000
      },
      "tenants": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tenant_access_token_env": { "type": "string", "minLength": 1 },
            "app_id_env": { "type": "string", "minLength": 1 },
            "app_secret_env": { "type": "string", "minLength": 1 }
          },
          "oneOf": [
            { "required": ["tenant_access_token_env"] },
            { "required": ["app_id_env", "app_secret_env"] }
          ]
        }
      }
    }
  }
}

